DATABASE_URL=postgres://knowthing:knowthing@localhost:5432/knowthing
UPLOAD_DIR=./uploads
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:5173
# Comma-separated production origins, IP headers, and reverse-proxy CIDRs.
# BETTER_AUTH_TRUSTED_ORIGINS=https://knowthing.example.com
# BETTER_AUTH_IP_HEADERS=x-real-ip
# BETTER_AUTH_TRUSTED_PROXIES=10.0.0.0/24
# Production also requires DOMAIN and a non-default DB_PASSWORD when using
# docker-compose.prod.yml.
