{
	"name": "knowthing",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"paraglide": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
		"prepare": "npm run paraglide && svelte-kit sync || echo ''",
		"check": "npm run paraglide && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"test": "vitest run",
		"test:watch": "vitest",
		"seed:assets:mars": "node scripts/fetch-mars-seed-assets.mjs",
		"db:migrate": "node --env-file=.env --loader ts-node/esm src/lib/server/db/migrate.ts"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.3",
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^2.22.0",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.2.2",
		"@types/bcrypt": "^6.0.0",
		"@types/three": "^0.185.4",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.1.0",
		"eslint-plugin-better-tailwindcss": "^4.3.2",
		"eslint-plugin-de-morgan": "^2.1.1",
		"eslint-plugin-svelte": "^3.15.2",
		"eslint-plugin-unicorn": "^63.0.0",
		"globals": "^17.4.0",
		"svelte": "^5.56.8",
		"svelte-check": "^4.4.2",
		"tailwindcss": "^4.2.2",
		"ts-node": "^10.9.2",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.57.1",
		"vite": "^7.3.6",
		"vitest": "^4.1.0"
	},
	"dependencies": {
		"@codemirror/autocomplete": "^6.20.1",
		"@codemirror/commands": "^6.10.3",
		"@codemirror/language": "^6.12.2",
		"@codemirror/search": "^6.6.0",
		"@codemirror/state": "^6.6.0",
		"@codemirror/view": "^6.40.0",
		"@fontsource/noto-serif": "^5.2.9",
		"@fontsource/work-sans": "^5.2.8",
		"@neodrag/svelte": "^2.3.3",
		"@sveltejs/adapter-node": "^5.5.7",
		"@tanstack/svelte-query": "^6.1.38",
		"bcrypt": "^6.0.0",
		"better-auth": "^1.6.25",
		"bits-ui": "^2.16.4",
		"camera-controls": "^3.1.2",
		"clsx": "^2.1.1",
		"diff": "^8.0.3",
		"drizzle-orm": "^0.45.2",
		"isomorphic-dompurify": "^3.19.0",
		"phosphor-svelte": "^3.1.0",
		"postgres": "^3.4.8",
		"rate-limiter-flexible": "^11.2.0",
		"rimecraft": "*",
		"runed": "^0.37.1",
		"sharp": "^0.35.3",
		"svelte-flag-icons": "^3.0.1",
		"svelte-sonner": "^1.1.1",
		"tailwind-merge": "^3.5.0",
		"three": "^0.185.1",
		"tungolcraft": "*",
		"zod": "^4.3.6"
	}
}
