{
	"name": "tungolcraft",
	"version": "0.1.0",
	"description": "An explainable astrophysics modelling toolkit for arbitrary rodder systems.",
	"type": "module",
	"license": "MIT",
	"author": "J. L. Bowden",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/RoseHobgoblin/KnowThing.git",
		"directory": "packages/tungolcraft"
	},
	"bugs": {
		"url": "https://github.com/RoseHobgoblin/KnowThing/issues"
	},
	"homepage": "https://github.com/RoseHobgoblin/KnowThing/tree/main/packages/tungolcraft#readme",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"keywords": [
		"astrophysics",
		"scientific-modelling",
		"worldbuilding",
		"orbital-mechanics",
		"kepler",
		"procedural-generation",
		"astronomy"
	],
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./schemas/scenario.schema.json": "./schemas/scenario.schema.json",
		"./schemas/scenario-report.schema.json": "./schemas/scenario-report.schema.json",
		"./schemas/external-run-request.schema.json": "./schemas/external-run-request.schema.json",
		"./schemas/external-run-result.schema.json": "./schemas/external-run-result.schema.json"
	},
	"files": [
		"benchmarks",
		"dist",
		"docs",
		"schemas"
	],
	"scripts": {
		"clean": "bun scripts/clean-distribution.mjs",
		"build": "bun run clean && tsc -p tsconfig.json",
		"benchmarks": "bun run build && bun scripts/run-benchmarks.mjs",
		"benchmarks:json": "bun scripts/run-benchmarks.mjs --json",
		"documentation:check": "bun scripts/generate-scientific-documentation.mjs --check",
		"prepack": "bun run build",
		"pack:smoke": "bun scripts/package-smoke.mjs",
		"prepublishOnly": "bun run test && bun run typecheck && bun run benchmarks && bun run documentation:check && bun run pack:smoke",
		"typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
		"test": "vitest run --config vitest.config.ts"
	}
}
