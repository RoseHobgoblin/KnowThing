{
	"name": "tungolcraft",
	"version": "0.1.0",
	"description": "An explainable astrophysics modelling toolkit for arbitrary celestial systems.",
	"type": "module",
	"license": "MIT",
	"author": "J. L. Bowden",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/RoseHobgoblin/KnowThing.git",
		"directory": "packages/tungolcraft"
	},
	"bugs": {
		"url": "https://github.com/RoseHobgoblin/KnowThing/issues"
	},
	"homepage": "https://github.com/RoseHobgoblin/KnowThing/tree/main/packages/tungolcraft#readme",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"keywords": [
		"astrophysics",
		"scientific-modelling",
		"worldbuilding",
		"orbital-mechanics",
		"kepler",
		"procedural-generation",
		"astronomy"
	],
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./schemas/scenario.schema.json": "./schemas/scenario.schema.json",
		"./schemas/scenario-report.schema.json": "./schemas/scenario-report.schema.json"
	},
	"files": [
		"dist",
		"docs",
		"schemas"
	],
	"scripts": {
		"clean": "node scripts/clean-distribution.mjs",
		"build": "npm run clean && tsc -p tsconfig.json",
		"prepack": "npm run build",
		"pack:smoke": "node scripts/package-smoke.mjs",
		"prepublishOnly": "npm run test && npm run typecheck && npm run pack:smoke",
		"typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
		"test": "vitest run --config vitest.config.ts"
	}
}
