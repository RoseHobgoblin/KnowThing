{
	"name": "tungolcraft",
	"version": "0.1.0",
	"description": "A generative astrophysics engine for worldbuilding: derive, validate, and place invented celestial bodies.",
	"type": "module",
	"license": "MIT",
	"keywords": [
		"astrophysics",
		"worldbuilding",
		"orbital-mechanics",
		"kepler",
		"procedural-generation",
		"astronomy"
	],
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"files": [
		"src",
		"dist",
		"docs"
	],
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
		"test": "vitest run --config vitest.config.ts"
	}
}
