{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/RoseHobgoblin/KnowThing/main/packages/tungolcraft/schemas/scenario-report.schema.json",
  "title": "Tungolcraft Scenario Report",
  "description": "Serializable multi-model results with explicit time, frames and dependencies.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "time",
    "frames",
    "results",
    "diagnostics",
    "dependencyGraph"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "scenarioId": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" },
    "time": {
      "$ref": "scenario.schema.json#/$defs/timeContext"
    },
    "frames": {
      "type": "array",
      "maxItems": 1000,
      "items": { "$ref": "scenario.schema.json#/$defs/referenceFrame" }
    },
    "results": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/modelResult" }
    },
    "diagnostics": {
      "type": "array",
      "items": { "$ref": "#/$defs/diagnostic" }
    },
    "dependencyGraph": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string", "minLength": 1 },
        "uniqueItems": true
      }
    }
  },
  "$defs": {
    "unit": {
      "enum": [
        "1",
        "rad",
        "deg",
        "s",
        "d",
        "m",
        "m/s",
        "m/s^2",
        "kg",
        "kg/m^3",
        "W",
        "W/m^2",
        "K",
        "m^3/s^2",
        "AU"
      ]
    },
    "inputRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "source"],
      "properties": {
        "value": { "type": ["number", "string", "boolean"] },
        "unit": { "$ref": "#/$defs/unit" },
        "source": { "enum": ["caller", "default", "derived"] },
        "uncertainty": { "$ref": "#/$defs/valueUncertainty" }
      }
    },
    "valueUncertainty": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value", "unit"],
          "properties": {
            "kind": { "const": "standard-deviation" },
            "value": { "type": "number", "minimum": 0 },
            "unit": { "$ref": "#/$defs/unit" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "lower", "upper", "unit"],
          "properties": {
            "kind": { "const": "interval" },
            "lower": { "type": "number" },
            "upper": { "type": "number" },
            "unit": { "$ref": "#/$defs/unit" },
            "confidence": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "values", "unit"],
          "properties": {
            "kind": { "const": "samples" },
            "values": {
              "type": "array",
              "minItems": 1,
              "maxItems": 10000,
              "items": { "type": "number" }
            },
            "unit": { "$ref": "#/$defs/unit" }
          }
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "citation"],
      "properties": {
        "type": {
          "enum": ["paper", "standard", "textbook", "derivation", "documentation"]
        },
        "citation": { "type": "string" },
        "doi": { "type": "string" },
        "url": { "type": "string" }
      }
    },
    "validityRule": {
      "type": "object",
      "minProperties": 1
    },
    "modelReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "title",
        "summary",
        "kind",
        "sources",
        "assumptions",
        "validity"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "title": { "type": "string" },
        "summary": { "type": "string" },
        "kind": {
          "enum": [
            "exact-relation",
            "numerical-solution",
            "approximation",
            "empirical-fit",
            "screening"
          ]
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/source" }
        },
        "assumptions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "validity": {
          "type": "array",
          "items": { "$ref": "#/$defs/validityRule" }
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "category", "severity", "message", "fields", "modelId"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "category": {
          "enum": [
            "invalid-input",
            "missing-input",
            "outside-domain",
            "numerical-failure",
            "approximation",
            "physical-warning"
          ]
        },
        "severity": { "enum": ["info", "warning", "error"] },
        "message": { "type": "string" },
        "fields": {
          "type": "array",
          "items": { "type": "string" }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": { "type": ["number", "string", "boolean"] }
        },
        "modelId": { "type": "string", "minLength": 1 }
      }
    },
    "numerical": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "converged"],
      "properties": {
        "method": { "type": "string" },
        "iterations": { "type": "number" },
        "residual": { "type": "number" },
        "tolerance": { "type": "number" },
        "converged": { "type": "boolean" }
      }
    },
    "uncertainty": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "not-provided" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "method", "value", "dependence", "evaluations"],
          "properties": {
            "kind": { "const": "propagated" },
            "method": { "const": "first-order" },
            "value": {
              "allOf": [
                { "$ref": "#/$defs/valueUncertainty" },
                { "properties": { "kind": { "const": "standard-deviation" } } }
              ]
            },
            "outputPath": {
              "type": "string",
              "pattern": "^[A-Z_a-z]\\w*(?:\\.[A-Z_a-z]\\w*)*$"
            },
            "dependence": { "enum": ["single-input", "independent"] },
            "evaluations": { "type": "integer", "minimum": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "method", "value", "dependence", "evaluations"],
          "properties": {
            "kind": { "const": "propagated" },
            "method": { "const": "interval" },
            "value": {
              "allOf": [
                { "$ref": "#/$defs/valueUncertainty" },
                { "properties": { "kind": { "const": "interval" } } }
              ]
            },
            "outputPath": {
              "type": "string",
              "pattern": "^[A-Z_a-z]\\w*(?:\\.[A-Z_a-z]\\w*)*$"
            },
            "dependence": { "const": "bounds-only" },
            "evaluations": { "type": "integer", "minimum": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "method",
            "value",
            "dependence",
            "seed",
            "sampleCount",
            "samplingPolicy",
            "evaluations"
          ],
          "properties": {
            "kind": { "const": "propagated" },
            "method": { "const": "monte-carlo" },
            "value": {
              "allOf": [
                { "$ref": "#/$defs/valueUncertainty" },
                { "properties": { "kind": { "const": "samples" } } }
              ]
            },
            "outputPath": {
              "type": "string",
              "pattern": "^[A-Z_a-z]\\w*(?:\\.[A-Z_a-z]\\w*)*$"
            },
            "dependence": { "enum": ["single-input", "independent"] },
            "seed": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
            "sampleCount": { "type": "integer", "minimum": 1, "maximum": 10000 },
            "samplingPolicy": { "enum": ["normal", "uniform", "empirical"] },
            "evaluations": { "type": "integer", "minimum": 1 }
          }
        }
      ]
    },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "output",
        "model",
        "inputs",
        "diagnostics",
        "uncertainty"
      ],
      "properties": {
        "ok": { "const": true },
        "output": {},
        "model": { "$ref": "#/$defs/modelReference" },
        "inputs": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/inputRecord" }
        },
        "diagnostics": {
          "type": "array",
          "items": { "$ref": "#/$defs/diagnostic" }
        },
        "numerical": { "$ref": "#/$defs/numerical" },
        "uncertainty": { "$ref": "#/$defs/uncertainty" }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "model", "inputs", "diagnostics"],
      "properties": {
        "ok": { "const": false },
        "model": { "$ref": "#/$defs/modelReference" },
        "inputs": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/inputRecord" }
        },
        "diagnostics": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/diagnostic" }
        }
      }
    },
    "modelResult": {
      "oneOf": [
        { "$ref": "#/$defs/success" },
        { "$ref": "#/$defs/failure" }
      ]
    }
  }
}
