{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/RoseHobgoblin/KnowThing/main/packages/tungolcraft/schemas/external-run-request.schema.json",
  "title": "Tungolcraft External Run Request",
  "description": "Versioned, engine-neutral handoff for external dynamics and climate engines.",
  "oneOf": [
    { "$ref": "#/$defs/dynamicsRequest" },
    { "$ref": "#/$defs/climateRequest" }
  ],
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" },
    "finiteNumber": { "type": "number" },
    "positiveNumber": { "type": "number", "exclusiveMinimum": 0 },
    "quantitySNonNegative": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit"],
      "properties": { "value": { "type": "number", "minimum": 0 }, "unit": { "const": "s" } }
    },
    "quantitySPositive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit"],
      "properties": { "value": { "$ref": "#/$defs/positiveNumber" }, "unit": { "const": "s" } }
    },
    "quantityKg": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit"],
      "properties": { "value": { "$ref": "#/$defs/positiveNumber" }, "unit": { "const": "kg" } }
    },
    "vectorM": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z", "unit"],
      "properties": {
        "x": { "$ref": "#/$defs/finiteNumber" }, "y": { "$ref": "#/$defs/finiteNumber" },
        "z": { "$ref": "#/$defs/finiteNumber" }, "unit": { "const": "m" }
      }
    },
    "vectorMps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z", "unit"],
      "properties": {
        "x": { "$ref": "#/$defs/finiteNumber" }, "y": { "$ref": "#/$defs/finiteNumber" },
        "z": { "$ref": "#/$defs/finiteNumber" }, "unit": { "const": "m/s" }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "velocity", "frameId"],
      "properties": {
        "position": { "$ref": "#/$defs/vectorM" },
        "velocity": { "$ref": "#/$defs/vectorMps" },
        "frameId": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "time": {
      "type": "object",
      "additionalProperties": false,
      "required": ["epoch", "scale", "secondsPerDay"],
      "properties": {
        "epoch": { "$ref": "#/$defs/nonEmptyString" },
        "scale": { "enum": ["model-day", "UTC", "TAI", "TT", "TDB"] },
        "secondsPerDay": { "$ref": "#/$defs/positiveNumber" }
      }
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startOffset", "duration", "outputInterval"],
      "properties": {
        "startOffset": { "$ref": "#/$defs/quantitySNonNegative" },
        "duration": { "$ref": "#/$defs/quantitySPositive" },
        "outputInterval": { "$ref": "#/$defs/quantitySPositive" }
      }
    },
    "engineBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "kind", "title"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "version": { "$ref": "#/$defs/nonEmptyString" },
        "kind": { "enum": ["dynamics", "climate"] },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "url": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "dynamicsEngine": { "$ref": "#/$defs/engineBase", "properties": { "kind": { "const": "dynamics" } } },
    "climateEngine": { "$ref": "#/$defs/engineBase", "properties": { "kind": { "const": "climate" } } },
    "numericParameter": {
      "type": "object", "additionalProperties": false, "required": ["id", "value", "unit"],
      "properties": { "id": { "$ref": "#/$defs/nonEmptyString" }, "value": { "$ref": "#/$defs/finiteNumber" }, "unit": { "$ref": "#/$defs/nonEmptyString" } }
    },
    "categoricalParameter": {
      "type": "object", "additionalProperties": false, "required": ["id", "value"],
      "properties": { "id": { "$ref": "#/$defs/nonEmptyString" }, "value": { "type": ["string", "boolean"] } }
    },
    "parameter": { "oneOf": [{ "$ref": "#/$defs/numericParameter" }, { "$ref": "#/$defs/categoricalParameter" }] },
    "baseProperties": {
      "schemaVersion": { "const": "1.0.0" },
      "requestId": { "$ref": "#/$defs/nonEmptyString" },
      "scenarioId": { "$ref": "#/$defs/nonEmptyString" },
      "kind": { "enum": ["dynamics", "climate"] },
      "engine": { "$ref": "#/$defs/engineBase" },
      "time": { "$ref": "#/$defs/time" },
      "window": { "$ref": "#/$defs/window" },
      "parameters": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/parameter" } }
    },
    "dynamicsBody": {
      "type": "object", "additionalProperties": false, "required": ["id", "mass", "initialState"],
      "properties": { "id": { "$ref": "#/$defs/nonEmptyString" }, "mass": { "$ref": "#/$defs/quantityKg" }, "initialState": { "$ref": "#/$defs/state" } }
    },
    "boundaryCondition": {
      "type": "object", "additionalProperties": false, "required": ["id", "quantity"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "quantity": {
          "type": "object", "additionalProperties": false, "required": ["value", "unit"],
          "properties": { "value": { "$ref": "#/$defs/finiteNumber" }, "unit": { "$ref": "#/$defs/nonEmptyString" } }
        }
      }
    },
    "dynamicsRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "requestId", "kind", "engine", "time", "window", "parameters", "frameId", "bodies"],
      "properties": {
        "schemaVersion": { "const": "1.0.0" }, "requestId": { "$ref": "#/$defs/nonEmptyString" }, "scenarioId": { "$ref": "#/$defs/nonEmptyString" },
        "kind": { "const": "dynamics" }, "engine": { "$ref": "#/$defs/dynamicsEngine" }, "time": { "$ref": "#/$defs/time" },
        "window": { "$ref": "#/$defs/window" }, "parameters": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/parameter" } },
        "frameId": { "$ref": "#/$defs/nonEmptyString" }, "bodies": { "type": "array", "minItems": 1, "maxItems": 10000, "items": { "$ref": "#/$defs/dynamicsBody" } }
      }
    },
    "climateRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "requestId", "kind", "engine", "time", "window", "parameters", "bodyId", "boundaryConditions"],
      "properties": {
        "schemaVersion": { "const": "1.0.0" }, "requestId": { "$ref": "#/$defs/nonEmptyString" }, "scenarioId": { "$ref": "#/$defs/nonEmptyString" },
        "kind": { "const": "climate" }, "engine": { "$ref": "#/$defs/climateEngine" }, "time": { "$ref": "#/$defs/time" },
        "window": { "$ref": "#/$defs/window" }, "parameters": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/parameter" } },
        "bodyId": { "$ref": "#/$defs/nonEmptyString" }, "boundaryConditions": { "type": "array", "minItems": 1, "maxItems": 1000, "items": { "$ref": "#/$defs/boundaryCondition" } }
      }
    }
  }
}
