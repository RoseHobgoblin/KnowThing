{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/RoseHobgoblin/KnowThing/main/packages/tungolcraft/schemas/external-run-result.schema.json",
  "title": "Tungolcraft External Run Result",
  "description": "Normalized, provenance-bearing output returned by an external dynamics or climate adapter.",
  "oneOf": [
    { "$ref": "#/$defs/dynamicsSuccess" },
    { "$ref": "#/$defs/climateSuccess" },
    { "$ref": "#/$defs/failure" }
  ],
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" },
    "finiteNumber": { "type": "number" },
    "quantityS": {
      "type": "object", "additionalProperties": false, "required": ["value", "unit"],
      "properties": { "value": { "type": "number", "minimum": 0 }, "unit": { "const": "s" } }
    },
    "vectorM": {
      "type": "object", "additionalProperties": false, "required": ["x", "y", "z", "unit"],
      "properties": { "x": { "$ref": "#/$defs/finiteNumber" }, "y": { "$ref": "#/$defs/finiteNumber" }, "z": { "$ref": "#/$defs/finiteNumber" }, "unit": { "const": "m" } }
    },
    "vectorMps": {
      "type": "object", "additionalProperties": false, "required": ["x", "y", "z", "unit"],
      "properties": { "x": { "$ref": "#/$defs/finiteNumber" }, "y": { "$ref": "#/$defs/finiteNumber" }, "z": { "$ref": "#/$defs/finiteNumber" }, "unit": { "const": "m/s" } }
    },
    "engine": {
      "type": "object", "additionalProperties": false, "required": ["id", "version", "kind", "title"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" }, "version": { "$ref": "#/$defs/nonEmptyString" },
        "kind": { "enum": ["dynamics", "climate"] }, "title": { "$ref": "#/$defs/nonEmptyString" }, "url": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false, "required": ["engine", "adapter"],
      "properties": {
        "engine": { "$ref": "#/$defs/engine" },
        "adapter": {
          "type": "object", "additionalProperties": false, "required": ["id", "version"],
          "properties": { "id": { "$ref": "#/$defs/nonEmptyString" }, "version": { "$ref": "#/$defs/nonEmptyString" } }
        }
      }
    },
    "diagnostic": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "category", "severity", "message", "fields", "modelId"],
      "properties": {
        "code": { "$ref": "#/$defs/nonEmptyString" },
        "category": { "enum": ["invalid-input", "missing-input", "outside-domain", "numerical-failure", "approximation", "physical-warning"] },
        "severity": { "enum": ["info", "warning", "error"] },
        "message": { "$ref": "#/$defs/nonEmptyString" },
        "fields": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } },
        "evidence": { "type": "object", "additionalProperties": { "type": ["number", "string", "boolean"] } },
        "modelId": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "baseProperties": {
      "schemaVersion": { "const": "1.0.0" }, "requestId": { "$ref": "#/$defs/nonEmptyString" },
      "scenarioId": { "$ref": "#/$defs/nonEmptyString" }, "kind": { "enum": ["dynamics", "climate"] },
      "provenance": { "$ref": "#/$defs/provenance" }, "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } },
      "ok": { "type": "boolean" }
    },
    "stateBody": {
      "type": "object", "additionalProperties": false, "required": ["id", "position", "velocity", "frameId"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" }, "position": { "$ref": "#/$defs/vectorM" },
        "velocity": { "$ref": "#/$defs/vectorMps" }, "frameId": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "stateSample": {
      "type": "object", "additionalProperties": false, "required": ["timeOffset", "bodies"],
      "properties": { "timeOffset": { "$ref": "#/$defs/quantityS" }, "bodies": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/stateBody" } } }
    },
    "valueSample": {
      "type": "object", "additionalProperties": false, "required": ["timeOffset", "value"],
      "properties": { "timeOffset": { "$ref": "#/$defs/quantityS" }, "value": { "$ref": "#/$defs/finiteNumber" } }
    },
    "channel": {
      "type": "object", "additionalProperties": false, "required": ["id", "unit", "samples"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" }, "unit": { "$ref": "#/$defs/nonEmptyString" },
        "samples": { "type": "array", "maxItems": 100000, "items": { "$ref": "#/$defs/valueSample" } }
      }
    },
    "dynamicsSuccess": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "requestId", "kind", "provenance", "diagnostics", "ok", "output"],
      "properties": {
        "schemaVersion": { "const": "1.0.0" }, "requestId": { "$ref": "#/$defs/nonEmptyString" }, "scenarioId": { "$ref": "#/$defs/nonEmptyString" },
        "kind": { "const": "dynamics" }, "provenance": { "$ref": "#/$defs/provenance" }, "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } }, "ok": { "const": true },
        "output": {
          "type": "object", "additionalProperties": false, "required": ["frameId", "samples"],
          "properties": { "frameId": { "$ref": "#/$defs/nonEmptyString" }, "samples": { "type": "array", "maxItems": 100000, "items": { "$ref": "#/$defs/stateSample" } } }
        }
      }
    },
    "climateSuccess": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "requestId", "kind", "provenance", "diagnostics", "ok", "output"],
      "properties": {
        "schemaVersion": { "const": "1.0.0" }, "requestId": { "$ref": "#/$defs/nonEmptyString" }, "scenarioId": { "$ref": "#/$defs/nonEmptyString" },
        "kind": { "const": "climate" }, "provenance": { "$ref": "#/$defs/provenance" }, "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } }, "ok": { "const": true },
        "output": { "type": "object", "additionalProperties": false, "required": ["channels"], "properties": { "channels": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/channel" } } } }
      }
    },
    "failure": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "requestId", "kind", "provenance", "diagnostics", "ok"],
      "properties": {
        "schemaVersion": { "const": "1.0.0" }, "requestId": { "$ref": "#/$defs/nonEmptyString" }, "scenarioId": { "$ref": "#/$defs/nonEmptyString" },
        "kind": { "enum": ["dynamics", "climate"] }, "provenance": { "$ref": "#/$defs/provenance" },
        "diagnostics": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/diagnostic" } }, "ok": { "const": false }
      }
    }
  }
}
